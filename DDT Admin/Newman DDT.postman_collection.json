    {
      "name": "SQL_XSS Login",
      "item": [
        {
          "name": "SQL_XSS Login",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const target = pm.iterationData.get(\"target_field\");",
                  "const payload = pm.iterationData.get(\"payload\");",
                  "",
                  "function randomValidEmail() {",
                  "    return `${Math.random().toString(36).slice(2, 10)}@example.com`;",
                  "}",
                  "function randomValidPassword() {",
                  "    return \"Qa\" + Math.random().toString(36).slice(2, 8) + \"1!\";",
                  "}",
                  "",
                  "pm.variables.set(\"sqlxss_username\", target === \"username\" ? payload : randomValidEmail());",
                  "pm.variables.set(\"sqlxss_password\", target === \"password\" ? payload : randomValidPassword());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const category = pm.iterationData.get(\"category\");",
                  "const payload = pm.iterationData.get(\"payload\");",
                  "",
                  "pm.test(\"Response time is acceptable\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1500);",
                  "});",
                  "",
                  "pm.test(`[${category}] payload rejected, response is not 2xx`, function () {",
                  "    pm.expect(pm.response.code, `payload: ${payload}`).to.not.be.within(200, 299);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{sqlxss_username}}\",\n  \"password\": \"{{sqlxss_password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
