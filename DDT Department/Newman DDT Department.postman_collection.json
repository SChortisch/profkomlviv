              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.sendRequest({",
                  "    url: \"http://localhost:8081/api/Admin/login\",",
                  "    method: \"POST\",",
                  "    header: { \"Content-Type\": \"application/json\" },",
                  "    body: {",
                  "        mode: \"raw\",",
                  "        raw: JSON.stringify({",
                  "            username: pm.variables.get(\"ddt_admin_user\"),",
                  "            password: pm.variables.get(\"ddt_admin_pass\")",
                  "        })",
                  "    }",
                  "}, function (err, res) {",
                  "    if (!err && res.code === 200) {",
                  "        pm.collectionVariables.set(\"ddt_token\", res.json().token);",
                  "    } else {",
                  "        console.error(\"Логін адміна не вдався — перевірте ddt_admin_user/ddt_admin_pass у DDT/ddt.postman_environment.json\", err || res.code);",
                  "    }",
                  "});",
                  "",
                  "const target = pm.iterationData.get(\"target_field\");",
                  "const payload = pm.iterationData.get(\"payload\");",
                  "",
                  "pm.variables.set(\"sqlxss_name\", target === \"Name\" ? payload : \"SQLXSS Dept\");",
                  "pm.variables.set(\"sqlxss_description\", target === \"Description\" ? payload : \"SQLXSS test description\");",
                  "pm.variables.set(\"sqlxss_logourl\", target === \"LogoUrl\" ? payload : \"\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const category = pm.iterationData.get(\"category\");",
                  "const payload = pm.iterationData.get(\"payload\");",
                  "",
                  "pm.test(\"Response time is acceptable\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1500);",
                  "});",
                  "",
                  "pm.test(`[${category}] payload rejected, response is not 2xx`, function () {",
                  "    pm.expect(pm.response.code, `payload: ${payload}`).to.not.be.within(200, 299);",
                  "});"
                ]
              }
            }
