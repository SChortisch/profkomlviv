{
  "info": {
    "_postman_id": "a1000000-0000-4000-8000-000000000003",
    "name": "Newman DDT Department",
    "description": "Виключно для Newman. Шість самодостатніх папок (без chaining/setNextRequest), кожна прогоняється окремою командою newman зі своїм CSV через -d. Функціональні папки перевіряють точний HTTP-код зі стовпця Expected result; SQL_XSS-папки перевіряють правило 2xx=fail. Запускати з теки Sprint4, щоб logo_path резолвився відносно working-dir.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create department DDT",
      "item": [
        {
          "name": "Create department DDT",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.sendRequest({",
                  "    url: \"http://localhost:8081/api/Admin/login\",",
                  "    method: \"POST\",",
                  "    header: { \"Content-Type\": \"application/json\" },",
                  "    body: {",
                  "        mode: \"raw\",",
                  "        raw: JSON.stringify({",
                  "            username: pm.variables.get(\"ddt_admin_user\"),",
                  "            password: pm.variables.get(\"ddt_admin_pass\")",
                  "        })",
                  "    }",
                  "}, function (err, res) {",
                  "    if (err || res.code !== 200) {",
                  "        console.error(\"Логін адміна не вдався — перевірте ddt_admin_user/ddt_admin_pass у DDT/ddt.postman_environment.json\", err || res.code);",
                  "        pm.variables.set(\"resolved_head_id\", pm.iterationData.get(\"HeadId\"));",
                  "        return;",
                  "    }",
                  "    const token = res.json().token;",
                  "    pm.collectionVariables.set(\"ddt_token\", token);",
                  "",
                  "    const headIdRaw = pm.iterationData.get(\"HeadId\");",
                  "    if (headIdRaw !== \"VALID\") {",
                  "        pm.variables.set(\"resolved_head_id\", headIdRaw);",
                  "        return;",
                  "    }",
                  "",
                  "    pm.sendRequest({",
                  "        url: \"http://localhost:8081/api/Team\",",
                  "        method: \"POST\",",
                  "        header: { Authorization: \"Bearer \" + token },",
                  "        body: {",
                  "            mode: \"formdata\",",
                  "            formdata: [",
                  "                { key: \"Name\", value: \"DDT Head\", type: \"text\" },",
                  "                { key: \"Position\", value: \"DDT\", type: \"text\" },",
                  "                { key: \"Type\", value: \"2\", type: \"text\" },",
                  "                { key: \"OrderInd\", value: \"0\", type: \"text\" },",
                  "                { key: \"IsTemporary\", value: \"true\", type: \"text\" }",
                  "            ]",
                  "        }",
                  "    }, function (teamErr, teamRes) {",
                  "        if (!teamErr && teamRes.code === 201) {",
                  "            pm.variables.set(\"resolved_head_id\", teamRes.json().id);",
                  "        } else {",
                  "            console.error(\"Не вдалося створити DDT Head\", teamErr || teamRes.code);",
                  "            pm.variables.set(\"resolved_head_id\", \"\");",
                  "        }",
                  "    });",
                  "});",
                  "",
                  "const logoPath = pm.iterationData.get(\"logo_path\");",
                  "const logoParam = pm.request.body.formdata.find((p) => p.key === \"Logo\");",
                  "if (logoParam) {",
                  "    logoParam.disabled = !logoPath;",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const expected = parseInt(pm.iterationData.get(\"Expected result\"), 10);",
                  "",
                  "pm.test(\"Response time is acceptable\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});",
                  "",
                  "pm.test(`DDT: status code matches Expected result (${expected})`, function () {",
                  "    pm.response.to.have.status(expected);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "Name", "value": "{{Name}}", "type": "text" },
                { "key": "Description", "value": "{{Description}}", "type": "text" },
                { "key": "HeadId", "value": "{{resolved_head_id}}", "type": "text" },
                { "key": "IsActive", "value": "{{IsActive}}", "type": "text" },
                { "key": "Logo", "type": "file", "src": "{{logo_path}}" }
              ]
            },
            "url": {
              "raw": "http://localhost:8081/api/departments",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8081",
              "path": ["api", "departments"]
            }
          },
          "response": []
        }
      ]
    },
