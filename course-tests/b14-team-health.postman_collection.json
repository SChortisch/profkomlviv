{
  "info": {
    "name": "Блок 14 · регресія BUG-001: список команди",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "113c5d04-d381-575f-ab6a-0e38178ddf28"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Уся команда",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/Team",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "Team"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Список команди читається: 200\", () => pm.response.to.have.status(200));",
              "console.log(pm.info.requestName + \" →\", pm.response.code);"
            ]
          }
        }
      ]
    },
    {
      "name": "Член команди №1",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/Team/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "Team",
            "1"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Член №1: 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}
