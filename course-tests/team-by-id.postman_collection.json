{
  "info": {
    "_postman_id": "bd1fc312-92a6-5b5c-801c-4aef98dca21b",
    "name": "Член команди за id (дані з CSV)",
    "description": "",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Член команди за id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/Team/{{id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "Team",
            "{{id}}"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Член команди \" + pm.iterationData.get(\"id\") + \" існує\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}