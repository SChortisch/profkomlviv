{
  "info": {
    "_postman_id": "e1000000-0000-4000-8000-000000000003",
    "name": "Newman DDT",
    "description": "Виключно для Newman. Шість самодостатніх папок (без chaining setNextRequest), кожна прогоняється окремою командою newman зі своїм CSV через -d. Перед запуском 'Update event DDT', 'Delete event DDT' та 'SQL_XSS Update event' виставте колекційну змінну event_target_id (id одноразового тестового Event).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create event DDT",
      "item": [
        {
          "name": "Create event DDT",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const title = String(pm.iterationData.get(\"Title\") ?? \"\");",
                  "const description = String(pm.iterationData.get(\"Description\") ?? \"\");",
                  "const startsAt = String(pm.iterationData.get(\"StartsAt\") ?? \"\");",
                  "const endsAt = String(pm.iterationData.get(\"EndsAt\") ?? \"\");",
                  "const location = String(pm.iterationData.get(\"Location\") ?? \"\");",
                  "const imageUrl = String(pm.iterationData.get(\"ImageUrl\") ?? \"\");",
                  "const idOverride = String(pm.iterationData.get(\"IdOverride\") ?? \"\");",
                  "",
                  "const body = { title: title, description: description, location: location };",
                  "if (startsAt !== \"\") body.startsAt = startsAt;",
                  "if (endsAt !== \"\") body.endsAt = endsAt;",
                  "if (imageUrl !== \"\") body.imageUrl = imageUrl;",
                  "if (idOverride !== \"\") body.id = parseInt(idOverride, 10);",
                  "",
                  "pm.request.body.raw = JSON.stringify(body);",
                  "",
                  "pm.sendRequest({",
                  "    url: \"http://localhost:8081/api/Admin/login\",",
                  "    method: \"POST\",",
                  "    header: { \"Content-Type\": \"application/json\" },",
                  "    body: {",
                  "        mode: \"raw\",",
                  "        raw: JSON.stringify({",
                  "            username: pm.variables.get(\"ddt_admin_user\"),",
                  "            password: pm.variables.get(\"ddt_admin_pass\")",
                  "        })",
                  "    }",
                  "}, function (err, res) {",
                  "    if (!err && res.code === 200) {",
                  "        pm.collectionVariables.set(\"ddt_token\", res.json().token);",
                  "    } else {",
                  "        console.error(\"Логін адміна не вдався — перевірте ddt_admin_user/ddt_admin_pass у DDT/ddt.postman_environment.json\", err || res.code);",
                  "    }",
                  "",
                  "    const authMode = pm.iterationData.get(\"AuthMode\") || \"valid\";",
                  "",
                  "    if (authMode === \"missing\") {",
                  "        pm.variables.set(\"run_token\", \"\");",
                  "    } else if (authMode === \"invalid\") {",
                  "        pm.variables.set(\"run_token\", \"invalid.jwt.token\");",
                  "    } else {",
                  "        pm.variables.set(\"run_token\", pm.collectionVariables.get(\"ddt_token\"));",
                  "    }",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const expected = parseInt(pm.iterationData.get(\"Expected result\"), 10);",
                  "",
                  "pm.test(\"Response time is acceptable\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});",
                  "",
                  "pm.test(`DDT: status code matches Expected result (${expected})`, function () {",
                  "    pm.response.to.have.status(expected);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
