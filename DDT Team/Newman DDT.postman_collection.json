      "name": "Create team DDT",
      "item": [
        {
          "name": "Create team DDT",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const name = String(pm.iterationData.get(\"Name\") ?? \"\");",
                  "const position = String(pm.iterationData.get(\"Position\") ?? \"\");",
                  "const type = String(pm.iterationData.get(\"Type\") ?? \"\");",
                  "const email = String(pm.iterationData.get(\"Email\") ?? \"\");",
                  "const orderInd = String(pm.iterationData.get(\"OrderInd\") ?? \"\");",
                  "const isTemporary = String(pm.iterationData.get(\"IsTemporary\") ?? \"\");",
                  "const isChoosed = String(pm.iterationData.get(\"IsChoosed\") ?? \"\");",
                  "const imageFilePath = String(pm.iterationData.get(\"ImageFilePath\") ?? \"\");",
                  "const imageUrl = String(pm.iterationData.get(\"ImageUrl\") ?? \"\");",
                  "",
                  "if (name === \"__EMPTY__\") {",
                  "    pm.request.body.formdata.add({ key: \"Name\", value: \"\", type: \"text\" });",
                  "} else if (name !== \"\") {",
                  "    pm.request.body.formdata.add({ key: \"Name\", value: name, type: \"text\" });",
                  "}",
                  "if (position === \"__EMPTY__\") {",
                  "    pm.request.body.formdata.add({ key: \"Position\", value: \"\", type: \"text\" });",
                  "} else if (position !== \"\") {",
                  "    pm.request.body.formdata.add({ key: \"Position\", value: position, type: \"text\" });",
                  "}",
                  "if (type !== \"\") pm.request.body.formdata.add({ key: \"Type\", value: type, type: \"text\" });",
                  "if (email !== \"\") pm.request.body.formdata.add({ key: \"Email\", value: email, type: \"text\" });",
                  "if (orderInd !== \"\") pm.request.body.formdata.add({ key: \"OrderInd\", value: orderInd, type: \"text\" });",
                  "if (isTemporary !== \"\") pm.request.body.formdata.add({ key: \"IsTemporary\", value: isTemporary, type: \"text\" });",
                  "if (isChoosed !== \"\") pm.request.body.formdata.add({ key: \"IsChoosed\", value: isChoosed, type: \"text\" });",
                  "if (imageFilePath !== \"\") pm.request.body.formdata.add({ key: \"Image\", src: imageFilePath, type: \"file\" });",
                  "if (imageUrl !== \"\") pm.request.body.formdata.add({ key: \"ImageUrl\", value: imageUrl, type: \"text\" });",
                  "",
                  "pm.sendRequest({",
                  "    url: \"http://localhost:8081/api/Admin/login\",",
                  "    method: \"POST\",",
                  "    header: { \"Content-Type\": \"application/json\" },",
                  "    body: {",
                  "        mode: \"raw\",",
                  "        raw: JSON.stringify({",
                  "            username: pm.variables.get(\"ddt_admin_user\"),",
                  "            password: pm.variables.get(\"ddt_admin_pass\")",
                  "        })",
                  "    }",
                  "}, function (err, res) {",
                  "    if (!err && res.code === 200) {",
                  "        pm.collectionVariables.set(\"ddt_token\", res.json().token);",
                  "    } else {",
                  "        console.error(\"Логін адміна не вдався — перевірте ddt_admin_user/ddt_admin_pass у DDT/ddt.postman_environment.json\", err || res.code);",
                  "    }",
                  "",
                  "    const authMode = pm.iterationData.get(\"AuthMode\") || \"valid\";",
                  "",
                  "    if (authMode === \"missing\") {",
                  "        pm.variables.set(\"run_token\", \"\");",
                  "    } else if (authMode === \"invalid\") {",
                  "        pm.variables.set(\"run_token\", \"invalid.jwt.token\");",
                  "    } else {",
                  "        pm.variables.set(\"run_token\", pm.collectionVariables.get(\"ddt_token\"));",
                  "    }",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const expected = parseInt(pm.iterationData.get(\"Expected result\"), 10);",
                  "",
                  "pm.test(\"Response time is acceptable\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});",
                  "",
                  "pm.test(`DDT: status code matches Expected result (${expected})`, function () {",
                  "    pm.response.to.have.status(expected);",
                  "});"
                ]
              }
            }
