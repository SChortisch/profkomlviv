    {
      "name": "SQL_XSS Create faculty",
      "item": [
        {
          "name": "SQL_XSS Create faculty",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const target = String(pm.iterationData.get(\"target_field\") ?? \"\");",
                  "const payload = String(pm.iterationData.get(\"payload\") ?? \"\");",
                  "",
                  "const defaults = {",
                  "    Name: \"SecurityDDT valid name\",",
                  "    Address: \"SecurityDDT valid address\",",
                  "    Room: \"101\",",
                  "    Instagram_Link: \"https://instagram.com/safe\",",
                  "    Telegram_Link: \"https://t.me/safe\",",
                  "    Schedule: \"Пн-Пт 9-18\",",
                  "    Summary: \"SecurityDDT valid summary\"",
                  "};",
                  "",
                  "function val(key) { return target === key ? payload : defaults[key]; }",
                  "",
                  "if (target === \"Name\" && payload === \"__EMPTY__\") {",
                  "    pm.request.body.formdata.add({ key: \"Name\", value: \"\", type: \"text\" });",
                  "} else {",
                  "    pm.request.body.formdata.add({ key: \"Name\", value: val(\"Name\"), type: \"text\" });",
                  "}",
                  "pm.request.body.formdata.add({ key: \"Address\", value: val(\"Address\"), type: \"text\" });",
                  "pm.request.body.formdata.add({ key: \"Room\", value: val(\"Room\"), type: \"text\" });",
                  "pm.request.body.formdata.add({ key: \"Instagram_Link\", value: val(\"Instagram_Link\"), type: \"text\" });",
                  "pm.request.body.formdata.add({ key: \"Telegram_Link\", value: val(\"Telegram_Link\"), type: \"text\" });",
                  "pm.request.body.formdata.add({ key: \"Schedule\", value: val(\"Schedule\"), type: \"text\" });",
                  "pm.request.body.formdata.add({ key: \"Summary\", value: val(\"Summary\"), type: \"text\" });",
                  "if (target === \"HeadId\") {",
                  "    pm.request.body.formdata.add({ key: \"HeadId\", value: payload, type: \"text\" });",
                  "}",
                  "",
                  "pm.sendRequest({",
                  "    url: \"http://localhost:8080/api/Admin/login\",",
                  "    method: \"POST\",",
                  "    header: { \"Content-Type\": \"application/json\" },",
                  "    body: {",
                  "        mode: \"raw\",",
                  "        raw: JSON.stringify({",
                  "            username: pm.variables.get(\"ddt_admin_user\"),",
                  "            password: pm.variables.get(\"ddt_admin_pass\")",
                  "        })",
                  "    }",
                  "}, function (err, res) {",
                  "    if (!err && res.code === 200) {",
                  "        pm.collectionVariables.set(\"ddt_token\", res.json().token);",
                  "    } else {",
                  "        console.error(\"Логін адміна не вдався — перевірте ddt_admin_user/ddt_admin_pass у DDT/ddt.postman_environment.json\", err || res.code);",
                  "    }",
                  "",
                  "    pm.variables.set(\"run_token\", pm.collectionVariables.get(\"ddt_token\"));",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const category = pm.iterationData.get(\"category\");",
                  "const payload = pm.iterationData.get(\"payload\");",
                  "",
                  "pm.test(\"Response time is acceptable\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});",
                  "",
                  "pm.test(`[${category}] payload rejected, response is not 2xx`, function () {",
                  "    pm.expect(pm.response.code, `payload: ${payload}`).to.not.be.within(200, 299);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{run_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": []
            },
            "url": {
              "raw": "http://localhost:8080/api/faculties",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "faculties"
              ]
            }
          },
          "response": []
        }
      ]
