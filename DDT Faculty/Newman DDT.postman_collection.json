    {
      "name": "Create faculty DDT",
      "item": [
        {
          "name": "Create faculty DDT",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const name = String(pm.iterationData.get(\"Name\") ?? \"\");",
                  "const headId = String(pm.iterationData.get(\"HeadId\") ?? \"\");",
                  "const address = String(pm.iterationData.get(\"Address\") ?? \"\");",
                  "const room = String(pm.iterationData.get(\"Room\") ?? \"\");",
                  "const instagramLink = String(pm.iterationData.get(\"Instagram_Link\") ?? \"\");",
                  "const telegramLink = String(pm.iterationData.get(\"Telegram_Link\") ?? \"\");",
                  "const schedule = String(pm.iterationData.get(\"Schedule\") ?? \"\");",
                  "const summary = String(pm.iterationData.get(\"Summary\") ?? \"\");",
                  "const isActive = String(pm.iterationData.get(\"IsActive\") ?? \"\");",
                  "const isCollege = String(pm.iterationData.get(\"IsCollege\") ?? \"\");",
                  "const imageFilePath = String(pm.iterationData.get(\"ImageFilePath\") ?? \"\");",
                  "const imageUrl = String(pm.iterationData.get(\"ImageUrl\") ?? \"\");",
                  "",
                  "if (name === \"__EMPTY__\") {",
                  "    pm.request.body.formdata.add({ key: \"Name\", value: \"\", type: \"text\" });",
                  "} else if (name !== \"\") {",
                  "    pm.request.body.formdata.add({ key: \"Name\", value: name, type: \"text\" });",
                  "}",
                  "if (headId !== \"\") pm.request.body.formdata.add({ key: \"HeadId\", value: headId, type: \"text\" });",
                  "if (address !== \"\") pm.request.body.formdata.add({ key: \"Address\", value: address, type: \"text\" });",
                  "if (room !== \"\") pm.request.body.formdata.add({ key: \"Room\", value: room, type: \"text\" });",
                  "if (instagramLink !== \"\") pm.request.body.formdata.add({ key: \"Instagram_Link\", value: instagramLink, type: \"text\" });",
                  "if (telegramLink !== \"\") pm.request.body.formdata.add({ key: \"Telegram_Link\", value: telegramLink, type: \"text\" });",
                  "if (schedule !== \"\") pm.request.body.formdata.add({ key: \"Schedule\", value: schedule, type: \"text\" });",
                  "if (summary !== \"\") pm.request.body.formdata.add({ key: \"Summary\", value: summary, type: \"text\" });",
                  "if (isActive !== \"\") pm.request.body.formdata.add({ key: \"IsActive\", value: isActive, type: \"text\" });",
                  "if (isCollege !== \"\") pm.request.body.formdata.add({ key: \"IsCollege\", value: isCollege, type: \"text\" });",
                  "if (imageFilePath !== \"\") pm.request.body.formdata.add({ key: \"Image\", src: imageFilePath, type: \"file\" });",
                  "if (imageUrl !== \"\") pm.request.body.formdata.add({ key: \"ImageUrl\", value: imageUrl, type: \"text\" });",
                  "",
                  "pm.sendRequest({",
                  "    url: \"http://localhost:8080/api/Admin/login\",",
                  "    method: \"POST\",",
                  "    header: { \"Content-Type\": \"application/json\" },",
                  "    body: {",
                  "        mode: \"raw\",",
                  "        raw: JSON.stringify({",
                  "            username: pm.variables.get(\"ddt_admin_user\"),",
                  "            password: pm.variables.get(\"ddt_admin_pass\")",
                  "        })",
                  "    }",
                  "}, function (err, res) {",
                  "    if (!err && res.code === 200) {",
                  "        pm.collectionVariables.set(\"ddt_token\", res.json().token);",
                  "    } else {",
                  "        console.error(\"Логін адміна не вдався — перевірте ddt_admin_user/ddt_admin_pass у DDT/ddt.postman_environment.json\", err || res.code);",
                  "    }",
                  "",
                  "    const authMode = pm.iterationData.get(\"AuthMode\") || \"valid\";",
                  "",
                  "    if (authMode === \"missing\") {",
                  "        pm.variables.set(\"run_token\", \"\");",
                  "    } else if (authMode === \"invalid\") {",
                  "        pm.variables.set(\"run_token\", \"invalid.jwt.token\");",
                  "    } else {",
                  "        pm.variables.set(\"run_token\", pm.collectionVariables.get(\"ddt_token\"));",
                  "    }",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const expected = parseInt(pm.iterationData.get(\"Expected result\"), 10);",
                  "",
                  "pm.test(\"Response time is acceptable\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});",
                  "",
                  "pm.test(`DDT: status code matches Expected result (${expected})`, function () {",
                  "    pm.response.to.have.status(expected);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
