    {
      "name": "Create news DDT",
      "item": [
        {
          "name": "Create news DDT",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const title = String(pm.iterationData.get(\"Title\") ?? \"\");",
                  "const content = String(pm.iterationData.get(\"Content\") ?? \"\");",
                  "const isImportant = String(pm.iterationData.get(\"IsImportant\") ?? \"\");",
                  "const imagesFilePaths = String(pm.iterationData.get(\"ImagesFilePaths\") ?? \"\");",
                  "",
                  "if (title === \"__EMPTY__\") {",
                  "    pm.request.body.formdata.add({ key: \"Title\", value: \"\", type: \"text\" });",
                  "} else if (title !== \"\") {",
                  "    pm.request.body.formdata.add({ key: \"Title\", value: title, type: \"text\" });",
                  "}",
                  "if (content !== \"\") pm.request.body.formdata.add({ key: \"Content\", value: content, type: \"text\" });",
                  "if (isImportant !== \"\") pm.request.body.formdata.add({ key: \"IsImportant\", value: isImportant, type: \"text\" });",
                  "if (imagesFilePaths !== \"\") {",
                  "    imagesFilePaths.split(\"|\").forEach(function (p) {",
                  "        pm.request.body.formdata.add({ key: \"Images\", src: p, type: \"file\" });",
                  "    });",
                  "}",
                  "",
                  "pm.sendRequest({",
                  "    url: \"http://localhost:8080/api/Admin/login\",",
                  "    method: \"POST\",",
                  "    header: { \"Content-Type\": \"application/json\" },",
                  "    body: {",
                  "        mode: \"raw\",",
                  "        raw: JSON.stringify({",
                  "            username: pm.variables.get(\"ddt_admin_user\"),",
                  "            password: pm.variables.get(\"ddt_admin_pass\")",
                  "        })",
                  "    }",
                  "}, function (err, res) {",
                  "    if (!err && res.code === 200) {",
                  "        pm.collectionVariables.set(\"ddt_token\", res.json().token);",
                  "    } else {",
                  "        console.error(\"Логін адміна не вдався — перевірте ddt_admin_user/ddt_admin_pass у DDT/ddt.postman_environment.json\", err || res.code);",
                  "    }",
                  "",
                  "    const authMode = pm.iterationData.get(\"AuthMode\") || \"valid\";",
                  "",
                  "    if (authMode === \"missing\") {",
                  "        pm.variables.set(\"run_token\", \"\");",
                  "    } else if (authMode === \"invalid\") {",
                  "        pm.variables.set(\"run_token\", \"invalid.jwt.token\");",
                  "    } else {",
                  "        pm.variables.set(\"run_token\", pm.collectionVariables.get(\"ddt_token\"));",
                  "    }",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const expected = parseInt(pm.iterationData.get(\"Expected result\"), 10);",
                  "",
                  "pm.test(\"Response time is acceptable\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});",
                  "",
                  "pm.test(`DDT: status code matches Expected result (${expected})`, function () {",
                  "    pm.response.to.have.status(expected);",
                  "});"
                ]
              }
            }
          ],
