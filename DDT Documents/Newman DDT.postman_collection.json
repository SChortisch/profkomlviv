{
  "info": {
    "_postman_id": "b2000000-0000-4000-8000-000000000003",
    "name": "Newman DDT",
    "description": "Виключно для Newman. Шість самодостатніх папок (без chaining), кожна прогоняється окремою командою newman зі своїм CSV через -d. POST/PUT/DELETE /api/documents захищені [Authorize(Roles=\"admin\")], тому кожен запит логіниться під admin@gmail.com у prerequest-скрипті (токен зчитується вже всередині callback логіну, щоб уникнути читання застарілого значення на першій ітерації). Update/Delete DDT потребують колекційної змінної doc_target_id (id реального, наперед створеного документа) — див. README.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create document DDT",
      "item": [
        {
          "name": "Create document DDT",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const title = String(pm.iterationData.get(\"Title\") ?? \"\");",
                  "const description = String(pm.iterationData.get(\"Description\") ?? \"\");",
                  "const filePath = String(pm.iterationData.get(\"FilePath\") ?? \"\");",
                  "",
                  "pm.request.body.formdata.add({ key: \"Title\", value: title, type: \"text\" });",
                  "if (description) {",
                  "    pm.request.body.formdata.add({ key: \"Description\", value: description, type: \"text\" });",
                  "}",
                  "if (filePath) {",
                  "    pm.request.body.formdata.add({ key: \"File\", src: filePath, type: \"file\" });",
                  "}",
                  "",
                  "pm.sendRequest({",
                  "    url: \"http://localhost:8080/api/Admin/login\",",
                  "    method: \"POST\",",
                  "    header: { \"Content-Type\": \"application/json\" },",
                  "    body: {",
                  "        mode: \"raw\",",
                  "        raw: JSON.stringify({ username: \"admin@gmail.com\", password: \"xb8InQ$w%8#^\" })",
                  "    }",
                  "}, function (err, res) {",
                  "    if (!err && res.code === 200) {",
                  "        pm.collectionVariables.set(\"ddt_token\", res.json().token);",
                  "    } else {",
                  "        console.error(\"Не вдалося отримати токен для DDT-запиту\", err || res.code);",
                  "    }",
                  "",
                  "    const authMode = pm.iterationData.get(\"AuthMode\") || \"valid\";",
                  "",
                  "    if (authMode === \"missing\") {",
                  "        pm.variables.set(\"run_token\", \"\");",
                  "    } else if (authMode === \"invalid\") {",
                  "        pm.variables.set(\"run_token\", \"invalid.jwt.token\");",
                  "    } else {",
                  "        pm.variables.set(\"run_token\", pm.collectionVariables.get(\"ddt_token\"));",
                  "    }",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const expected = parseInt(pm.iterationData.get(\"Expected result\"), 10);",
                  "",
                  "pm.test(\"Response time is acceptable\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});",
                  "",
                  "pm.test(`DDT: status code matches Expected result (${expected})`, function () {",
                  "    pm.response.to.have.status(expected);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{run_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": []
            },
            "url": {
              "raw": "http://localhost:8080/api/documents",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "documents"
              ]
            }
          },
          "response": []
        }
      ]
    },
