    {
      "name": "SQL_XSS Create document",
      "item": [
        {
          "name": "SQL_XSS Create document",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const target = String(pm.iterationData.get(\"target_field\") ?? \"\");",
                  "const payload = String(pm.iterationData.get(\"payload\") ?? \"\");",
                  "",
                  "const defaultTitle = \"SecurityDDT valid title\";",
                  "const defaultDescription = \"SecurityDDT valid description\";",
                  "const fixedFile = \"E:/Study/Profkom site/Sprint4/data/Documents/smoke_documents.xlsx\";",
                  "",
                  "const title = target === \"Title\" ? payload : defaultTitle;",
                  "const description = target === \"Description\" ? payload : defaultDescription;",
                  "",
                  "pm.request.body.formdata.add({ key: \"Title\", value: title, type: \"text\" });",
                  "pm.request.body.formdata.add({ key: \"Description\", value: description, type: \"text\" });",
                  "pm.request.body.formdata.add({ key: \"File\", src: fixedFile, type: \"file\" });",
                  "",
                  "pm.sendRequest({",
                  "    url: \"http://localhost:8080/api/Admin/login\",",
                  "    method: \"POST\",",
                  "    header: { \"Content-Type\": \"application/json\" },",
                  "    body: {",
                  "        mode: \"raw\",",
                  "        raw: JSON.stringify({ username: \"admin@gmail.com\", password: \"xb8InQ$w%8#^\" })",
                  "    }",
                  "}, function (err, res) {",
                  "    if (!err && res.code === 200) {",
                  "        pm.collectionVariables.set(\"ddt_token\", res.json().token);",
                  "    } else {",
                  "        console.error(\"Не вдалося отримати токен для DDT-запиту\", err || res.code);",
                  "    }",
                  "",
                  "    pm.variables.set(\"run_token\", pm.collectionVariables.get(\"ddt_token\"));",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const category = pm.iterationData.get(\"category\");",
                  "const payload = pm.iterationData.get(\"payload\");",
                  "",
                  "pm.test(\"Response time is acceptable\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});",
                  "",
                  "pm.test(`[${category}] payload rejected, response is not 2xx`, function () {",
                  "    pm.expect(pm.response.code, `payload: ${payload}`).to.not.be.within(200, 299);",
                  "});"
                ]
              }
            }
          ],
